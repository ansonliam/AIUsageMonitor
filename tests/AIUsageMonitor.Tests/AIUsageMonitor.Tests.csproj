<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keeps test builds out of src/AIUsageMonitor/bin so `dotnet test` still works while a
         locally running AIUsageMonitor.exe holds that folder's DLL/exe locked. -->
    <BaseOutputPath>bin_test\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AIUsageMonitor\AIUsageMonitor.csproj">
      <AdditionalProperties>BaseOutputPath=bin_test\</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
