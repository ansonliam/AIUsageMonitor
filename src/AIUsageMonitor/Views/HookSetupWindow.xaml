<Window x:Class="AIUsageMonitor.Views.HookSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up automatic refresh"
        Width="500"
        SizeToContent="Height"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F8FA"
        Foreground="#FF20252B">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFEAF4FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF78A9D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD6E9FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF4D8DC4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1F3F5" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD5DAE0" />
                                <Setter Property="Foreground" Value="#FF929AA3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Set up automatic refresh" />
        <TextBlock Grid.Row="1" Margin="0,10,0,16" TextWrapping="Wrap"
                   Text="AI Usage Monitor found these installed clients. Select the hooks to install or repair. Clients that are not installed are not shown." />
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Options}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Margin="0,4" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="3" Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="84" Margin="0,0,8,0" Padding="8,4" IsCancel="True" Content="Not now" />
            <Button Width="145" Padding="8,4" IsDefault="True" Click="SetUp_Click" Content="Set up selected" />
        </StackPanel>
    </Grid>
</Window>
