<Window x:Class="AIUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels"
        Title="AI Usage Monitor Settings"
        Width="780"
        Height="790"
        MinWidth="700"
        MinHeight="500"
        Background="#FFF7F8FA"
        Foreground="#FF20252B"
        Icon="/AIUsageMonitor;component/Assets/AIUsageMonitor.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFEAF4FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF78A9D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD6E9FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF4D8DC4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1F3F5" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD5DAE0" />
                                <Setter Property="Foreground" Value="#FF929AA3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="#FFFFFFFF"
                                BorderBrush="#FFC6CCD3"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L4,5 L8,0 Z"
                                      Fill="#FF65717D" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFEAF4FF" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF78A9D4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFD6E9FA" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF4D8DC4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFEAF4FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD6E9FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFC6CCD3"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                           Direction="270"
                                                           Opacity="0.15"
                                                           ShadowDepth="2"
                                                           Color="#FF20252B" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF929AA3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF3B6FB0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="#FF1F4E85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="18,12,18,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold" Text="Window" />
        <Border Grid.Row="1"
                Margin="0,8,0,10"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsWindowLocked, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Content="Lock window position and size" />
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsHorizontalLayout, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Content="Side-by-side layout" />
                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Content="Always on top" />
                </Grid>
                <TextBlock Margin="22,4,0,0"
                           Foreground="#FF65717D"
                           Text="When unlocked, drag the widget body to move it and drag any edge or corner to resize it." />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Visible:" />
                    <CheckBox IsChecked="{Binding ShowCodex, Mode=TwoWay}" Content="Codex" />
                    <CheckBox Margin="18,0,0,0"
                              IsChecked="{Binding ShowClaude, Mode=TwoWay}"
                              Content="Claude" />
                    <CheckBox Margin="18,0,0,0"
                              IsChecked="{Binding ShowAntigravity, Mode=TwoWay}"
                              Content="Antigravity" />
                    <CheckBox Margin="18,0,0,0"
                              IsChecked="{Binding ShowCursor, Mode=TwoWay}"
                              Content="Cursor" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Content="Scheduled refresh" />
                    <Button Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ResetScheduledIntervalsCommand}"
                            Content="Reset to default"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
                <WrapPanel Margin="22,7,0,0"
                           IsEnabled="{Binding AutoRefreshEnabled}"
                           Orientation="Horizontal">
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Codex every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding CodexRefreshIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Claude every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding ClaudeRefreshIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Antigravity every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding AntigravityRefreshIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Cursor every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding CursorRefreshIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Hook throttle refresh" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FF65717D"
                               Text="(minimum time between automatic refreshes)" />
                    <Button Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ResetThrottleIntervalsCommand}"
                            Content="Reset to default"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
                <WrapPanel Margin="22,7,0,0" Orientation="Horizontal">
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Codex every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding CodexThrottleIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Claude every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding ClaudeThrottleIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Antigravity every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding AntigravityThrottleIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Cursor every" />
                        <TextBox Width="58"
                                 Margin="8,0,4,0"
                                 Padding="7,3"
                                 HorizontalContentAlignment="Right"
                                 Background="#FFFFFFFF"
                                 BorderBrush="#FFBFC7D1"
                                 Foreground="#FF20252B"
                                 Text="{Binding CursorThrottleIntervalMinutes, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="min" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Text size" />
                    <ComboBox Width="110"
                              Margin="16,0,0,0"
                              ItemsSource="{Binding FontSizePresets}"
                              SelectedItem="{Binding FontSizePreset, Mode=TwoWay}" />
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Font" />
                    <ComboBox Width="160"
                              Margin="16,0,0,0"
                              ItemsSource="{Binding WidgetFonts}"
                              SelectedItem="{Binding WidgetFont, Mode=TwoWay}" />
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Text weight" />
                    <ComboBox Width="110"
                              Margin="16,0,0,0"
                              ItemsSource="{Binding WidgetTextWeights}"
                              SelectedItem="{Binding WidgetTextWeight, Mode=TwoWay}" />
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Appearance" />
                    <ComboBox Width="110"
                              Margin="16,0,0,0"
                              ItemsSource="{Binding WidgetAppearances}"
                              SelectedItem="{Binding WidgetAppearance, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,14,0,4" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Usage colour stages" />
                    <Button Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ResetUsageColorsCommand}"
                            Content="Reset to default"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,3,20,3" Orientation="Horizontal">
                        <TextBlock Width="55" VerticalAlignment="Center" Text="Stage 1" />
                        <TextBox Width="90" Text="{Binding GreenColorHex}" />
                        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="up to" />
                        <TextBox Width="40" Text="{Binding Stage1MaxPercent}" />
                        <TextBlock VerticalAlignment="Center" Text="%" />
                    </StackPanel>
                    <StackPanel Margin="0,3,0,3" Orientation="Horizontal">
                        <TextBlock Width="55" VerticalAlignment="Center" Text="Stage 2" />
                        <TextBox Width="90" Text="{Binding LimeColorHex}" />
                        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="up to" />
                        <TextBox Width="40" Text="{Binding Stage2MaxPercent}" />
                        <TextBlock VerticalAlignment="Center" Text="%" />
                    </StackPanel>
                    <StackPanel Margin="0,3,20,3" Orientation="Horizontal">
                        <TextBlock Width="55" VerticalAlignment="Center" Text="Stage 3" />
                        <TextBox Width="90" Text="{Binding YellowColorHex}" />
                        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="up to" />
                        <TextBox Width="40" Text="{Binding Stage3MaxPercent}" />
                        <TextBlock VerticalAlignment="Center" Text="%" />
                    </StackPanel>
                    <StackPanel Margin="0,3,0,3" Orientation="Horizontal">
                        <TextBlock Width="55" VerticalAlignment="Center" Text="Stage 4" />
                        <TextBox Width="90" Text="{Binding OrangeColorHex}" />
                        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="up to" />
                        <TextBox Width="40" Text="{Binding Stage4MaxPercent}" />
                        <TextBlock VerticalAlignment="Center" Text="%" />
                    </StackPanel>
                    <StackPanel Margin="0,3,20,3" Orientation="Horizontal">
                        <TextBlock Width="55" VerticalAlignment="Center" Text="Stage 5" />
                        <TextBox Width="90" Text="{Binding RedColorHex}" />
                        <TextBlock Margin="8,0,4,0" VerticalAlignment="Center" Text="up to" />
                        <TextBox Width="40" Text="{Binding Stage5MaxPercent}" />
                        <TextBlock VerticalAlignment="Center" Text="%" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button Width="112"
                            Command="{Binding ApplyUsageColorsCommand}"
                            Content="Apply Stages" />
                    <StackPanel x:Name="DeveloperControls"
                                Margin="10,0,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF6B4F00"
                                   Text="Developer mode" />
                        <Button Command="{Binding OpenIconPreviewCommand}"
                                Content="Open Icon Preview" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" FontSize="16" FontWeight="SemiBold" Text="Integrations" />
        <Border Grid.Row="3"
                Margin="0,8,0,6"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="Codex" />
                    <StackPanel Margin="0,4,12,0" Orientation="Horizontal">
                        <TextBlock Text="Hook status: " />
                        <TextBlock Text="{Binding CodexHookStatus, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Margin="0,3,12,0"
                               FontSize="10"
                               Foreground="#FF65717D"
                               Text="{Binding CodexHookPath}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="8,0,6,0" Command="{Binding InstallCodexHookCommand}" Content="Install / Repair Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding UninstallCodexHookCommand}" Content="Uninstall Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding TestCodexHookCommand}" Content="Test Hook" />
                    <Button Command="{Binding OpenCodexHookFileCommand}" Content="Open Hook File" ToolTip="{Binding CodexHookPath}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="4"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Claude Code" />
                    <StackPanel Margin="0,4,12,0" Orientation="Horizontal">
                        <TextBlock Text="Hook status: " />
                        <TextBlock Text="{Binding ClaudeHookStatus, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Margin="0,3,12,0"
                               FontSize="10"
                               Foreground="#FF65717D"
                               Text="{Binding ClaudeHookPath}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="8,0,6,0" Command="{Binding InstallClaudeHookCommand}" Content="Install / Repair Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding UninstallClaudeHookCommand}" Content="Uninstall Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding TestClaudeHookCommand}" Content="Test Hook" />
                    <Button Command="{Binding OpenClaudeHookFileCommand}" Content="Open Hook File" ToolTip="{Binding ClaudeHookPath}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Margin="0,6,0,0"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Google Antigravity" />
                    <StackPanel Margin="0,4,12,0" Orientation="Horizontal">
                        <TextBlock Text="Hook status: " />
                        <TextBlock Text="{Binding AntigravityHookStatus, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Margin="0,3,12,0"
                               FontSize="10"
                               Foreground="#FF65717D"
                               Text="{Binding AntigravityHookPath}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="8,0,6,0" Command="{Binding InstallAntigravityHookCommand}" Content="Install / Repair Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding UninstallAntigravityHookCommand}" Content="Uninstall Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding TestAntigravityHookCommand}" Content="Test Hook" />
                    <Button Command="{Binding OpenAntigravityHookFileCommand}" Content="Open Hook File" ToolTip="{Binding AntigravityHookPath}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Margin="0,6,0,0"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Cursor" />
                    <StackPanel Margin="0,4,12,0" Orientation="Horizontal">
                        <TextBlock Text="Hook status: " />
                        <TextBlock Text="{Binding CursorHookStatus, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Margin="0,3,12,0"
                               FontSize="10"
                               Foreground="#FF65717D"
                               Text="{Binding CursorHookPath}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="8,0,6,0" Command="{Binding InstallCursorHookCommand}" Content="Install / Repair Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding UninstallCursorHookCommand}" Content="Uninstall Hook" />
                    <Button Margin="0,0,6,0" Command="{Binding TestCursorHookCommand}" Content="Test Hook" />
                    <Button Command="{Binding OpenCursorHookFileCommand}" Content="Open Hook File" ToolTip="{Binding CursorHookPath}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="7" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="API Cost" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="#FF65717D"
                           Text="Track spend for a Codex Azure/OpenAI endpoint (the host your Codex API key actually calls, not your personal ChatGPT login) or a Claude AWS Bedrock endpoint. Add one per API key/subscription you want tracked separately."
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#FF65717D"
                           Text="Pricing currency: AUD  All rates are AUD per 1 million tokens."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Command="{Binding AddCodexApiEndpointCommand}" Content="+ Add Endpoint" />
        </Grid>
        <StackPanel Grid.Row="8" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding CodexApiEndpoints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="10"
                                Background="#FFFFFFFF"
                                BorderBrush="#FFD6DBE1"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="10" Foreground="#FF65717D" Text="Provider" />
                                        <ComboBox Width="170"
                                                  ItemsSource="{x:Static vm:CodexApiEndpointSettingsViewModel.TypeOptions}"
                                                  SelectedItem="{Binding TypeDisplayText, Mode=TwoWay}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="Show in widget"
                                              IsChecked="{Binding ShowInWidget, Mode=TwoWay}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock FontSize="10" Foreground="#FF65717D" Text="Name" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Margin="0,0,6,0">
                                            <StackPanel Visibility="{Binding IsCodexType, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock FontSize="10" Foreground="#FF65717D" Text="Azure OpenAI Endpoint" />
                                                <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="The Azure/OpenAI host your Codex config points at for this API key (e.g. b2c-codex.openai.azure.com). Used only to match usage from Codex's own logs to this endpoint - never called or contacted directly." />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding IsClaudeType, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock FontSize="10" Foreground="#FF65717D" Text="AWS Region (optional)" />
                                                <TextBox Text="{Binding AwsRegion, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="The AWS region this Bedrock endpoint runs in (e.g. us-east-1). Only needed if you configure more than one Claude AWS Bedrock endpoint - with a single one, all detected Bedrock usage is attributed to it automatically." />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock FontSize="10" Foreground="#FF65717D" Text="Track From" />
                                            <TextBox Text="{Binding TrackFromText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock FontSize="10" Foreground="#FF65717D" Text="Currency" />
                                            <TextBlock Margin="4,5,0,0" Text="AUD" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                        <TextBlock FontSize="10" Text=" " />
                                        <Button Command="{Binding DeleteCommand}" Content="Delete" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock FontSize="10" Foreground="#FF65717D" Text="Monthly Budget (optional)" />
                                        <TextBox Text="{Binding MonthlyBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock FontSize="10" Foreground="#FF65717D" Text="Manual Cost Adjustment (AUD)" />
                                        <TextBox Text="{Binding ManualCostAdjustmentText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter an AUD difference, e.g. 12 changes a $31 estimate to $43. Supports negative values too." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding IsCodexType, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="10" Foreground="#FF65717D" Text="Azure Cache Match Rate % (optional)" />
                                        <TextBox Text="{Binding CacheHitRateText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Your Azure provider-reported prompt cache match rate. Used only when a Codex session record has no cached-token telemetry." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="10"
                                           Foreground="#FF65717D"
                                           Text="The manual adjustment is added to Today, 7 Days, and Month. Update it when reconciling against your provider's actual cost."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="10"
                                           Foreground="#FF65717D"
                                           Visibility="{Binding IsCodexType, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Text="Optional: enter Azure Cost Management's Prompt Token Cache Match Rate (for example 5.22). It is used only when a session record has no cached-token count; exact cached-token counts in Codex logs always take precedence."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,4"
                                           FontSize="10"
                                           Foreground="#FF65717D"
                                           Text="{Binding PricingHelpText}"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="10" FontWeight="SemiBold" Foreground="#FF65717D" Text="Model" />
                                    <TextBlock Grid.Column="1" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" Foreground="#FF65717D" Text="Input" ToolTip="AUD / 1M tokens" />
                                    <TextBlock Grid.Column="2" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" Foreground="#FF65717D" Text="Cached Input" ToolTip="AUD / 1M tokens" />
                                    <TextBlock Grid.Column="3" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" Foreground="#FF65717D" Text="Cache Write" ToolTip="AUD / 1M tokens" />
                                    <TextBlock Grid.Column="4" Margin="0,0,8,0" FontSize="10" FontWeight="SemiBold" Foreground="#FF65717D" Text="Output" ToolTip="AUD / 1M tokens" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PricingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding DisplayName}"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding DisplayName}" />
                                                    <TextBox Grid.Column="1"
                                                             Margin="0,0,4,0"
                                                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="AUD / 1M tokens" />
                                                    <TextBox Grid.Column="2"
                                                             Margin="0,0,4,0"
                                                             Text="{Binding CachedInputText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="AUD / 1M tokens" />
                                                    <TextBox Grid.Column="3"
                                                             Margin="0,0,4,0"
                                                             Text="{Binding CacheWriteText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="AUD / 1M tokens" />
                                                    <TextBox Grid.Column="4"
                                                             Margin="0,0,8,0"
                                                             Text="{Binding OutputText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="AUD / 1M tokens" />
                                                    <Button Grid.Column="5"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Command="{Binding ResetToDefaultCommand}"
                                                            Content="Clear pricing" />
                                                </Grid>
                                                <TextBlock Margin="186,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#FF9AA3AC"
                                                           Text="{Binding DefaultHintText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding SaveCodexApiEndpointsCommand}" Content="Save API Endpoints" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF4E5964"
                           Text="{Binding CodexApiCostStatus}"
                           TextWrapping="Wrap" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="9"
                   Margin="0,8,0,0"
                   Foreground="#FF4E5964"
                   Text="{Binding TestResult}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="10" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="76" IsCancel="True" IsDefault="True" Content="Close" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
