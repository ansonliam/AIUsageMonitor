<Window x:Class="AIUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AIUsageMonitor.Converters"
        xmlns:services="clr-namespace:AIUsageMonitor.Services"
        xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels"
        Title="{Binding SettingsWindowTitle}"
        Width="940"
        Height="790"
        MinWidth="900"
        MinHeight="500"
        Background="#FFF7F8FA"
        Foreground="#FF20252B"
        Icon="/AIUsageMonitor;component/Assets/AIUsageMonitor.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:HookStatusColorConverter x:Key="HookStatusColorConverter" />
        <converters:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFEAF4FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF78A9D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFD6E9FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF4D8DC4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1F3F5" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFD5DAE0" />
                                <Setter Property="Foreground" Value="#FF929AA3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ClickMode" Value="Press" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="#FFFFFFFF"
                                BorderBrush="#FFC6CCD3"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L4,5 L8,0 Z"
                                      Fill="#FF65717D" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFEAF4FF" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF78A9D4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#FFD6E9FA" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#FF4D8DC4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFEAF4FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFD6E9FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Margin="0,2,0,0"
                                        Background="#FFFFFFFF"
                                        BorderBrush="#FFC6CCD3"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                           Direction="270"
                                                           Opacity="0.15"
                                                           ShadowDepth="2"
                                                           Color="#FF20252B" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF929AA3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#FF20252B" />
            <Setter Property="BorderBrush" Value="#FFC6CCD3" />
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FF3B6FB0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="#FF1F4E85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="#FF65717D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontWeight="SemiBold"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFEAF4FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF3B6FB0" />
                                <Setter Property="Foreground" Value="#FF20252B" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FFF7F8FA" />
            <Setter Property="BorderBrush" Value="#FFD6DBE1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#FFF7F8FA"
                                    BorderBrush="#FFD6DBE1"
                                    BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel"
                                          Margin="8,0,0,0"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl Margin="10,10,10,8">
        <TabItem Header="General">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,10,8,8">

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Widget Visibility" />
        <Border Margin="0,8,0,10"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Grid.IsSharedSizeScope="True">
                <CheckBox Margin="0,0,0,12"
                          IsChecked="{Binding ShowAtWindowsStartup, Mode=TwoWay}"
                          FontWeight="SemiBold"
                          Content="Show app at Windows startup" />
                <TextBlock Margin="0,0,0,6" FontSize="11" Foreground="#FF65717D" Text="WINDOW WIDGET" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="WidgetVisibilityToggle" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Margin="0,0,24,0"
                              IsChecked="{Binding ShowDashboardWidget, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              Content="Show main window" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Width="55"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Visible:" />
                        <CheckBox IsChecked="{Binding ShowCodex, Mode=TwoWay}" Content="Codex" />
                        <CheckBox Margin="18,0,0,0"
                                  IsChecked="{Binding ShowClaude, Mode=TwoWay}"
                                  Content="Claude" />
                        <CheckBox Margin="18,0,0,0"
                                  IsChecked="{Binding ShowAntigravity, Mode=TwoWay}"
                                  Content="Antigravity" />
                        <CheckBox Margin="18,0,0,0"
                                  IsChecked="{Binding ShowCursor, Mode=TwoWay}"
                                  Content="Cursor" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,16,0,6" FontSize="11" Foreground="#FF65717D" Text="TASKBAR WIDGET" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="WidgetVisibilityToggle" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Margin="0,0,24,0"
                              IsChecked="{Binding ShowTaskbarWidget, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              Content="Show usage in Windows taskbar" />
                    <StackPanel Grid.Column="1"
                                IsEnabled="{Binding ShowTaskbarWidget}"
                                Orientation="Horizontal">
                        <TextBlock Width="55"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Visible:" />
                        <CheckBox IsChecked="{Binding ShowCodexOnTaskbar, Mode=TwoWay}" Content="Codex" />
                        <CheckBox Margin="18,0,0,0"
                                  IsChecked="{Binding ShowClaudeOnTaskbar, Mode=TwoWay}"
                                  Content="Claude" />
                        <CheckBox Margin="18,0,0,0"
                                  IsChecked="{Binding ShowAntigravityOnTaskbar, Mode=TwoWay}"
                                  Content="Antigravity" />
                        <CheckBox Margin="18,0,0,0"
                                  IsChecked="{Binding ShowCursorOnTaskbar, Mode=TwoWay}"
                                  Content="Cursor" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Antigravity" />
        <Border Margin="0,8,0,10"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <CheckBox IsChecked="{Binding HideAntigravityClaudeAndGptModels, Mode=TwoWay}"
                          Content="Hide Claude and ChatGPT models" />
                <TextBlock Margin="22,4,0,0"
                           FontSize="11"
                           Foreground="#FF65717D"
                           TextWrapping="Wrap"
                           Text="Hide their Antigravity 5-hour and weekly limits in the window and taskbar widgets." />
                <CheckBox Margin="0,12,0,0"
                          IsChecked="{Binding HideAntigravityFiveHourLimits, Mode=TwoWay}"
                          Content="Hide 5-hour limits" />
                <TextBlock Margin="22,4,0,0"
                           FontSize="11"
                           Foreground="#FF65717D"
                           TextWrapping="Wrap"
                           Text="Hide Antigravity 5H rows in the window and taskbar widgets. Weekly limits stay visible." />
            </StackPanel>
        </Border>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Window Widget" />
        <Border Margin="0,8,0,10"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsWindowLocked, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Content="Lock window position and size" />
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                              FontWeight="SemiBold"
                              Content="Always on top" />
                </Grid>
                <TextBlock Margin="22,4,0,0"
                           Foreground="#FF65717D"
                           Text="When unlocked, drag the widget body to move it and drag any edge or corner to resize it." />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Dashboard widget height:" />
                    <TextBox Width="64"
                             Margin="8,0,4,0"
                             Padding="7,3"
                             HorizontalContentAlignment="Right"
                             Background="#FFFFFFFF"
                             BorderBrush="#FFBFC7D1"
                             Foreground="#FF20252B"
                             Text="{Binding DashboardWidgetHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="px (minimum 1)" />
                </StackPanel>
                <TextBlock Margin="0,3,0,0"
                           Foreground="#FF65717D"
                           Text="Used by Dashboard Layout. This is the height of one grid unit; widgets spanning two units are twice as tall." />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Usage label width:" />
                    <TextBox Width="64"
                             Margin="8,0,4,0"
                             Padding="7,3"
                             HorizontalContentAlignment="Right"
                             Background="#FFFFFFFF"
                             BorderBrush="#FFBFC7D1"
                             Foreground="#FF20252B"
                             Text="{Binding MetricLabelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="px" />
                </StackPanel>
                <TextBlock Margin="0,3,0,0"
                           Foreground="#FF65717D"
                           Text="Controls the left usage label column (for example, 5H) while keeping Reset text aligned." />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Progress bar height:" />
                    <TextBox Width="64"
                             Margin="8,0,4,0"
                             Padding="7,3"
                             HorizontalContentAlignment="Right"
                             Background="#FFFFFFFF"
                             BorderBrush="#FFBFC7D1"
                             Foreground="#FF20252B"
                             Text="{Binding ProgressBarHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="px (minimum 1)" />
                </StackPanel>
                <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Text size" />
                        <ComboBox Width="95"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding FontSizePresets}"
                                  SelectedItem="{Binding FontSizePreset, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Font" />
                        <ComboBox Width="160"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding WidgetFonts}"
                                  SelectedItem="{Binding WidgetFont, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Text weight" />
                        <ComboBox Width="90"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding WidgetTextWeights}"
                                  SelectedItem="{Binding WidgetTextWeight, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Appearance" />
                        <ComboBox Width="90"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding WidgetAppearances}"
                                  SelectedItem="{Binding WidgetAppearance, Mode=TwoWay}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Taskbar Widget" />
        <Border Margin="0,8,0,10"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Foreground="#FF65717D"
                           Text="Displays a compact, read-only usage strip beside the system tray icons and clock. Independent of the main window. Visibility and toggles are controlled from the Show section above."
                           TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding ShowTaskbarWidget}">
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Font" />
                        <ComboBox Width="160"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding TaskbarFonts}"
                                  SelectedItem="{Binding TaskbarFont, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,28,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Text weight" />
                        <ComboBox Width="110"
                                  Margin="16,0,0,0"
                                  ItemsSource="{Binding TaskbarTextWeights}"
                                  SelectedItem="{Binding TaskbarTextWeight, Mode=TwoWay}" />
                    </StackPanel>
                </WrapPanel>
                <CheckBox Margin="0,10,0,0"
                          IsChecked="{Binding SyncTaskbarMonitorAppearance, Mode=TwoWay}"
                          Content="Sync size and vertical adjustment across enabled monitors" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding TaskbarMonitors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding DisplayName}" />
                                <Border Grid.Column="1"
                                        Width="46"
                                        Height="20"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="#FFD6DBE1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="AlignToggle_Click"
                                        ToolTip="Align widget to the left or right edge of this monitor's taskbar">
                                    <Grid>
                                        <Border Width="20"
                                                Height="20"
                                                Background="#FF4D8DC4"
                                                CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlignRight}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Margin="6,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   IsHitTestVisible="False"
                                                   Text="L" />
                                        <TextBlock Margin="0,0,6,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   IsHitTestVisible="False"
                                                   Text="R" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2" Margin="12,0,5,0" VerticalAlignment="Center" Text="Text px" />
                                <TextBox Grid.Column="3" HorizontalContentAlignment="Right" Text="{Binding TextSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="4" Margin="12,0,5,0" VerticalAlignment="Center" Text="Icon px" />
                                <TextBox Grid.Column="5" HorizontalContentAlignment="Right" Text="{Binding IconSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="6" Margin="12,0,5,0" VerticalAlignment="Center" Text="Vertical px" />
                                <TextBox Grid.Column="7" HorizontalContentAlignment="Right" Text="{Binding TextVerticalOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="8" Orientation="Horizontal" Visibility="{Binding ShowOffsetField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="12,0,5,0" VerticalAlignment="Center" Text="Offset px" />
                                    <TextBox Width="40" HorizontalContentAlignment="Right" Text="{Binding OffsetPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Usage Colour Stages" />
        <Border Margin="0,8,0,10"
                Padding="10"
                Background="#FFFFFFFF"
                BorderBrush="#FFD6DBE1"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <CheckBox Margin="0,0,0,8"
                          Content="Show remaining instead of used"
                          IsChecked="{Binding ShowUsageRemaining, Mode=TwoWay}"
