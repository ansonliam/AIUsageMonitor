<Window x:Class="AIUsageMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AIUsageMonitor.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels"
        Title="AI Usage Monitor"
        Width="302"
        Height="230"
        MinWidth="220"
        MinHeight="145"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text"
        Foreground="#F2F5F8"
        Icon="/AIUsageMonitor;component/Assets/AIUsageMonitor.ico"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:UsageColorConverter x:Key="UsageColorConverter" />
        <system:Double x:Key="ProviderFontSize">11.5</system:Double>
        <system:Double x:Key="MetricFontSize">15</system:Double>
        <system:Double x:Key="ResetFontSize">9.5</system:Double>
        <system:Double x:Key="ActionFontSize">10</system:Double>
        <system:Double x:Key="ProviderHeaderHeight">19</system:Double>
        <system:Double x:Key="MetricRowHeight">19</system:Double>
        <ItemsPanelTemplate x:Key="VerticalProvidersPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalProvidersPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <Style x:Key="CompactProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#3D4249" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:UsageMetricViewModel}">
            <StackPanel Margin="3,0,3,2" ToolTip="{Binding ResetToolTip}">
                <Grid Height="{DynamicResource MetricRowHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabelColumn" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{DynamicResource MetricFontSize}"
                               FontWeight="Bold"
                               Foreground="#F5F7FA"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,7,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource ResetFontSize}"
                               Foreground="#9DA7B2"
                               Text="{Binding ResetText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               MinWidth="34"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource MetricFontSize}"
                               FontWeight="Bold"
                               Foreground="#F5F7FA"
                               Text="{Binding PercentText}"
                               TextAlignment="Right" />
                </Grid>
                <ProgressBar Margin="0,1,0,0"
                             Foreground="{Binding UsedPercent, Converter={StaticResource UsageColorConverter}}"
                             Style="{StaticResource CompactProgressBarStyle}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
            <Border Margin="0,0,2,3"
                    Padding="8,3,8,3"
                    Background="#E62A2F38"
                    BorderThickness="0"
                    CornerRadius="10"
                    ToolTip="{Binding HoverText}"
                    ToolTipService.InitialShowDelay="250"
                    ToolTipService.ShowDuration="20000">
                <StackPanel>
                    <Grid Height="{DynamicResource ProviderHeaderHeight}"
                          Margin="2,0,1,1"
                          ToolTip="{Binding HoverText}"
                          ToolTipService.InitialShowDelay="250"
                          ToolTipService.ShowDuration="20000">
                        <TextBlock VerticalAlignment="Center"
                                   AutomationProperties.HelpText="{Binding HoverText}"
                                   FontSize="{DynamicResource ProviderFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="#DCE3EA"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding HoverText}"
                                   ToolTipService.InitialShowDelay="200"
                                   ToolTipService.ShowDuration="20000" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Height="{DynamicResource ProviderHeaderHeight}"
                                    MinHeight="{DynamicResource ProviderHeaderHeight}"
                                    Margin="0,0,4,0"
                                    Padding="7,1"
                                    Command="{Binding LoginCommand}"
                                    Content="Login"
                                    FontSize="{DynamicResource ActionFontSize}"
                                    Visibility="{Binding ShowLogin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Width="{DynamicResource ProviderHeaderHeight}"
                                    Height="{DynamicResource ProviderHeaderHeight}"
                                    MinHeight="{DynamicResource ProviderHeaderHeight}"
                                    Padding="3"
                                    AutomationProperties.Name="Refresh"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding RefreshCommand}"
                                    Focusable="False"
                                    Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                    ToolTip="Refresh">
                                <iconPacks:PackIconMaterial Width="12" Height="12" Foreground="#DDE4EA" Kind="Refresh" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding UsageWindows}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="Transparent" BorderThickness="0">
        <Border.ContextMenu>
            <ContextMenu Opened="WidgetContextMenu_Opened">
                <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
                <MenuItem Header="Refresh All" Click="RefreshAllMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="OpacityMenuItem" Header="Opacity">
                    <MenuItem Header="100%" Tag="1.0" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="90%" Tag="0.9" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="80%" Tag="0.8" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="70%" Tag="0.7" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="60%" Tag="0.6" Click="OpacityMenuItem_Click" />
                </MenuItem>
                <MenuItem x:Name="FontSizeMenuItem" Header="Text Size">
                    <MenuItem Header="Compact" Tag="Compact" Click="FontSizeMenuItem_Click" />
                    <MenuItem Header="Small" Tag="Small" Click="FontSizeMenuItem_Click" />
                    <MenuItem Header="Normal" Tag="Normal" Click="FontSizeMenuItem_Click" />
                    <MenuItem Header="Large" Tag="Large" Click="FontSizeMenuItem_Click" />
                    <MenuItem Header="Extra Large" Tag="Extra Large" Click="FontSizeMenuItem_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="LockWindowMenuItem" Click="LockWindowMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProvidersItemsControl"
                          Grid.IsSharedSizeScope="True"
                          VerticalAlignment="Top"
                          ItemsPanel="{StaticResource VerticalProvidersPanel}"
                          ItemsSource="{Binding Providers}" />
        </ScrollViewer>
    </Border>
</Window>
