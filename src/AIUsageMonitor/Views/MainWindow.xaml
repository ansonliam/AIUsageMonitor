<Window x:Class="AIUsageMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AIUsageMonitor.Controls"
        xmlns:converters="clr-namespace:AIUsageMonitor.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels"
        Title="AI Usage Monitor"
        Width="430"
        Height="320"
        MinWidth="160"
        MinHeight="145"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="1.0"
        FontFamily="{DynamicResource WidgetFontFamily}"
        Foreground="#F2F5F8"
        Icon="/AIUsageMonitor;component/Assets/AIUsageMonitor.ico"
        ResizeMode="CanResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        LostMouseCapture="Window_LostMouseCapture"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:UsageColorConverter x:Key="UsageColorConverter" />
        <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Text</FontFamily>
        <FontWeight x:Key="MetricFontWeight">Bold</FontWeight>
        <FontWeight x:Key="ProviderFontWeight">SemiBold</FontWeight>
        <SolidColorBrush x:Key="ProviderCardBackground" Color="#E62A2F38" />
        <SolidColorBrush x:Key="ProviderCardBorderBrush" Color="Transparent" />
        <Thickness x:Key="ProviderCardBorderThickness">0</Thickness>
        <CornerRadius x:Key="ProviderCardCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="ProgressCornerRadius">3</CornerRadius>

        <system:Double x:Key="ProviderFontSize">11.5</system:Double>
        <system:Double x:Key="MetricFontSize">15</system:Double>
        <system:Double x:Key="ResetFontSize">9.5</system:Double>
        <system:Double x:Key="ActionFontSize">10</system:Double>
        <system:Double x:Key="ProviderHeaderHeight">19</system:Double>
        <system:Double x:Key="ProviderIconSize">13</system:Double>
        <system:Double x:Key="MetricRowHeight">19</system:Double>
        <GridLength x:Key="MetricLabelWidth">32</GridLength>
        <ItemsPanelTemplate x:Key="VerticalProvidersPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalProvidersPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <system:Double x:Key="ProgressBarHeight">6</system:Double>
        <Style x:Key="CompactProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="{DynamicResource ProgressBarHeight}" />
            <Setter Property="Background" Value="#3D4249" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource ProgressCornerRadius}" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{DynamicResource ProgressCornerRadius}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:UsageMetricViewModel}">
            <StackPanel Margin="3,0,3,2" ToolTip="{Binding HoverText}">
                <Grid Height="{DynamicResource MetricRowHeight}">
                    <Grid.ColumnDefinitions>
                        <!-- Fixed label column keeps every Reset value aligned, regardless of
                             whether the provider uses W, G, C, or the wider 5H label. -->
                        <ColumnDefinition Width="{DynamicResource MetricLabelWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               MaxWidth="150"
                               FontSize="{DynamicResource MetricFontSize}"
                               FontWeight="{DynamicResource MetricFontWeight}"
                               Foreground="#F5F7FA"
                               Text="{Binding ShortLabel}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding HoverText}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,7,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource ResetFontSize}"
                               Foreground="#9DA7B2"
                               Text="{Binding ResetText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               MinWidth="34"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource MetricFontSize}"
                               FontWeight="{DynamicResource MetricFontWeight}"
                               Foreground="#F5F7FA"
                               Text="{Binding PercentText}"
                               TextAlignment="Right" />
                </Grid>
                <ProgressBar Margin="0,1,0,0"
                             Foreground="{Binding UsedPercent, Converter={StaticResource UsageColorConverter}}"
                             Style="{StaticResource CompactProgressBarStyle}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProviderViewModel}">
            <Border Margin="0,0,2,2"
                    Padding="8,3,8,3"
                    Background="{DynamicResource ProviderCardBackground}"
                    BorderBrush="{DynamicResource ProviderCardBorderBrush}"
                    BorderThickness="{DynamicResource ProviderCardBorderThickness}"
                    CornerRadius="{DynamicResource ProviderCardCornerRadius}"
                    ToolTip="{Binding HoverText}"
                    ToolTipService.InitialShowDelay="250"
                    ToolTipService.ShowDuration="20000">
                <StackPanel>
                    <Grid Height="{DynamicResource ProviderHeaderHeight}"
                          Margin="2,0,1,1"
                          ToolTip="{Binding HoverText}"
                          ToolTipService.InitialShowDelay="250"
                          ToolTipService.ShowDuration="20000">
                        <TextBlock x:Name="ProviderNameText"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HelpText="{Binding HoverText}"
                                   FontSize="{DynamicResource ProviderFontSize}"
                                   FontWeight="{DynamicResource ProviderFontWeight}"
                                   Foreground="#DCE3EA"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding HoverText}"
                                   ToolTipService.InitialShowDelay="200"
                                   ToolTipService.ShowDuration="20000" />
                        <Image x:Name="ProviderIconImage"
                               Width="{DynamicResource ProviderIconSize}"
                               Height="{DynamicResource ProviderIconSize}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               AutomationProperties.HelpText="{Binding HoverText}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"
                               ToolTip="{Binding HoverText}"
                               ToolTipService.InitialShowDelay="200"
                               ToolTipService.ShowDuration="20000"
                               Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Height="{DynamicResource ProviderHeaderHeight}"
                                    MinHeight="{DynamicResource ProviderHeaderHeight}"
                                    Margin="0,0,4,0"
                                    Padding="7,1"
                                    Command="{Binding LoginCommand}"
                                    Content="Login"
                                    FontSize="{DynamicResource ActionFontSize}"
                                    Visibility="{Binding ShowLogin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Width="{DynamicResource ProviderHeaderHeight}"
                                    Height="{DynamicResource ProviderHeaderHeight}"
                                    MinHeight="{DynamicResource ProviderHeaderHeight}"
                                    Padding="3"
                                    AutomationProperties.Name="Refresh"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding RefreshCommand}"
                                    Focusable="False"
                                    Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                    ToolTip="Refresh">
                                <iconPacks:PackIconMaterial Width="12" Height="12" Foreground="#DDE4EA" Kind="Refresh" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding UsageWindows}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Claude">
                    <Setter TargetName="ProviderNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ProviderIconImage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/claude.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Antigravity">
                    <Setter TargetName="ProviderNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ProviderIconImage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/antigravity.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Cursor">
                    <Setter TargetName="ProviderNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ProviderIconImage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/cursor.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Codex">
                    <Setter TargetName="ProviderNameText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ProviderIconImage" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/codex.png" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CodexApiCostPanelViewModel}">
            <Border Margin="0,0,2,2"
                    Padding="8,3,8,3"
                    Background="{DynamicResource ProviderCardBackground}"
                    BorderBrush="{DynamicResource ProviderCardBorderBrush}"
                    BorderThickness="{DynamicResource ProviderCardBorderThickness}"
                    CornerRadius="{DynamicResource ProviderCardCornerRadius}">
                <StackPanel>
                    <Grid Height="{DynamicResource ProviderHeaderHeight}" Margin="2,0,1,1">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{DynamicResource ProviderFontSize}"
                                   FontWeight="{DynamicResource ProviderFontWeight}"
                                   Foreground="#DCE3EA"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource ResetFontSize}"
                                       Foreground="#9DA7B2"
                                       Text="{Binding PercentText}"
                                       Visibility="{Binding HasBudget, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="3,0,3,1"
                               FontSize="{DynamicResource ResetFontSize}"
                               Foreground="#9DA7B2"
                               Text="Estimated cost (AUD)" />
                    <Grid Margin="3,0,3,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock FontSize="{DynamicResource ResetFontSize}" Foreground="#9DA7B2" Text="Month" />
                            <TextBlock FontSize="11"
                                       FontWeight="{DynamicResource MetricFontWeight}"
                                       Foreground="#F5F7FA"
                                       Text="{Binding MonthText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding MonthText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,3,0">
                            <TextBlock FontSize="{DynamicResource ResetFontSize}" Foreground="#9DA7B2" Text="7 Days" />
                            <TextBlock FontSize="11"
                                       FontWeight="{DynamicResource MetricFontWeight}"
                                       Foreground="#F5F7FA"
                                       Text="{Binding SevenDayText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding SevenDayText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="{DynamicResource ResetFontSize}" Foreground="#9DA7B2" Text="Today" />
                            <TextBlock FontSize="11"
                                       FontWeight="{DynamicResource MetricFontWeight}"
                                       Foreground="#F5F7FA"
                                       Text="{Binding TodayText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding TodayText}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Margin="3,0,3,2"
                                 Foreground="{Binding UsedPercent, Converter={StaticResource UsageColorConverter}}"
                                 Style="{StaticResource CompactProgressBarStyle}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding HasBudget, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="3,1,3,0"
                               FontSize="{DynamicResource ResetFontSize}"
                               Foreground="#9DA7B2"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               ToolTip="{Binding StatusText}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="Transparent" BorderThickness="0">
        <Border.ContextMenu>
            <ContextMenu Opened="WidgetContextMenu_Opened">
                <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
                <MenuItem Header="Refresh All" Click="RefreshAllMenuItem_Click" />
                <Separator />
                <MenuItem Header="Layout">
                    <MenuItem x:Name="HorizontalLayoutMenuItem"
                              Click="HorizontalLayoutMenuItem_Click"
                              Header="Horizontal"
                              IsCheckable="True" />
                    <MenuItem x:Name="VerticalLayoutMenuItem"
                              Click="VerticalLayoutMenuItem_Click"
                              Header="Vertical"
                              IsCheckable="True" />
                    <MenuItem x:Name="DashboardLayoutMenuItem"
                              Click="DashboardLayoutMenuItem_Click"
                              Header="Dashboard"
                              IsCheckable="True" />
                </MenuItem>
                <MenuItem x:Name="EditDashboardLayoutMenuItem"
                          Click="EditDashboardLayoutMenuItem_Click"
                          Header="Edit Layout" />
                <MenuItem x:Name="ResetDashboardLayoutMenuItem"
                          Click="ResetDashboardLayoutMenuItem_Click"
                          Header="Reset Layout" />
                <Separator />
                <MenuItem x:Name="OpacityMenuItem" Header="Opacity">
                    <MenuItem Header="100%" Tag="1.0" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="90%" Tag="0.9" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="80%" Tag="0.8" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="70%" Tag="0.7" Click="OpacityMenuItem_Click" />
                    <MenuItem Header="60%" Tag="0.6" Click="OpacityMenuItem_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="AlwaysOnTopMenuItem"
                          Click="AlwaysOnTopMenuItem_Click"
                          Header="Always on Top"
                          IsCheckable="True" />
                <MenuItem x:Name="LockWindowMenuItem" Click="LockWindowMenuItem_Click" />
                <Separator />
                <!-- Hides this widget only; the app keeps running in the tray (which is also how
                     it comes back - tray Open, or the Settings checkbox). Deliberately not an
                     app-exit item: that stays on the tray icon, where it can't be hit by someone
                     aiming to dismiss the widget. -->
                <MenuItem Header="Hide Widget" Click="HideWidgetMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <!-- Normal compact widget content - unchanged from before the dashboard feature.
                 Visibility is toggled in code-behind by ApplyDashboardLayoutMode(). -->
            <ScrollViewer x:Name="CompactContentScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CompactItemsControl"
                              Grid.IsSharedSizeScope="True"
                              VerticalAlignment="Top"
                              ItemsPanel="{StaticResource VerticalProvidersPanel}"
                              ItemsSource="{Binding CompactPanels}" />
            </ScrollViewer>

            <!-- Opt-in free-form dashboard grid. DashboardGrid itself has no static
                 RowDefinitions/ColumnDefinitions in markup - MainWindow.xaml.cs builds and
                 maintains them from DashboardLayoutViewModel.Rows/Columns/Cards, since WPF has no
                 built-in way to bind a Grid's RowDefinitions count to a view model collection. -->
            <ScrollViewer x:Name="DashboardScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <!-- No MinHeight: the grid's own height (row count x DashboardWidgetHeight) is
                     the whole content height, and a floor here would show up as invisible window
                     below the last card that the widget cannot be dragged past. -->
                <Grid>
                    <Border x:Name="DashboardEditBackground"
                            Background="#66FFFFFF"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    <Grid x:Name="DashboardGrid"
                          VerticalAlignment="Top" />
                    <Canvas x:Name="DashboardGridOverlay"
                            IsHitTestVisible="False"
                            Panel.ZIndex="1"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>

            <!-- Explicit window resize affordance: the app also supports edge resizing, but this
                 makes the intended bottom-right interaction discoverable when dashboard cards
                 extend beyond the current widget height. -->
            <Thumb x:Name="WindowResizeThumb"
                   Width="22"
                   Height="22"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,3,3"
                   Cursor="SizeNWSE"
                   DragCompleted="WindowResizeThumb_DragCompleted"
                   DragDelta="WindowResizeThumb_DragDelta"
                   Panel.ZIndex="2"
                   ToolTip="Resize widget">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="#59000000">
                            <Path Data="M5,18 L18,5 M10,18 L18,10 M15,18 L18,15"
                                  Stroke="#E6F2F5F8"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
