<Window x:Class="AIUsageMonitor.Views.IconPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AIUsageMonitor.Converters"
        xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels"
        Title="AI Usage Monitor — Icon Screenshot Preview"
        Width="512"
        Height="512"
        Background="#FF272B33"
        FontFamily="Segoe UI Variable Text"
        Foreground="#FFF4F6F8"
        Icon="/AIUsageMonitor;component/Assets/AIUsageMonitor.ico"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <converters:UsageColorConverter x:Key="UsageColorConverter" />

        <Style x:Key="PreviewProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="22" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#FF464B53" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="11" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="11" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:UsageMetricViewModel}">
            <StackPanel Margin="0,5,0,24">
                <Grid Height="112">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="82"
                               FontWeight="Bold"
                               Text="{Binding Label}" />
                    <TextBlock MinWidth="205"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="82"
                               FontWeight="Bold"
                               Text="{Binding PercentText}"
                               TextAlignment="Right" />
                </Grid>
                <ProgressBar Foreground="{Binding UsedPercent, Converter={StaticResource UsageColorConverter}}"
                             Style="{StaticResource PreviewProgressBar}"
                             Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="#FF272B33">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Close Preview" Click="ClosePreviewMenuItem_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <StackPanel Margin="28,20" VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,4"
                       FontSize="52"
                       FontWeight="SemiBold"
                       Foreground="#FFDCE2E8"
                       Text="Claude/Codex" />
            <ItemsControl ItemsSource="{Binding ClaudeProvider.UsageWindows}" />
        </StackPanel>
    </Grid>
</Window>
