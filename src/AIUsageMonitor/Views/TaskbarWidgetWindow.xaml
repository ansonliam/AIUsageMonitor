<Window x:Class="AIUsageMonitor.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AIUsageMonitor.Converters"
        xmlns:vm="clr-namespace:AIUsageMonitor.ViewModels"
        Title="AI Usage Monitor - Taskbar"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Width"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        TextOptions.TextFormattingMode="Display">
    <Window.ContextMenu>
        <ContextMenu Closed="ContextMenu_Closed">
            <MenuItem Header="Open" Click="OpenMenuItem_Click" />
            <MenuItem Header="Settings" Click="SettingsMenuItem_Click" />
            <MenuItem Header="Refresh All" Click="RefreshAllMenuItem_Click" />
            <Separator />
            <MenuItem Header="Close" Click="CloseMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <converters:UsageColorConverter x:Key="UsageColorConverter" />

        <Style x:Key="TaskbarTooltipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>

        <DataTemplate x:Key="TaskbarUsageMetricTooltipTemplate" DataType="{x:Type vm:UsageMetricViewModel}">
            <TextBlock Style="{StaticResource TaskbarTooltipTextStyle}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1} — {2}">
                        <Binding Path="Label" />
                        <Binding Path="PercentText" />
                        <Binding Path="ResetText" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="TaskbarUsageMetricTemplate" DataType="{x:Type vm:UsageMetricViewModel}">
            <TextBlock Margin="3,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{Binding UsedPercent, Converter={StaticResource UsageColorConverter}}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}:{1}">
                        <Binding Path="ShortLabel" />
                        <Binding Path="PercentText" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="TaskbarProviderTemplate" DataType="{x:Type vm:ProviderViewModel}">
            <StackPanel Margin="6,0,0,0"
                        Orientation="Horizontal"
                        ToolTipService.InitialShowDelay="250"
                        ToolTipService.ShowDuration="20000">
                <StackPanel.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource TaskbarTooltipTextStyle}"
                                       Text="{Binding StatusText, StringFormat='Status: {0}'}" />
                            <TextBlock Style="{StaticResource TaskbarTooltipTextStyle}"
                                       Text="{Binding LastUpdatedText, StringFormat='Last updated: {0}'}" />
                            <ItemsControl ItemsSource="{Binding UsageWindows}"
                                          ItemTemplate="{StaticResource TaskbarUsageMetricTooltipTemplate}" />
                        </StackPanel>
                    </ToolTip>
                </StackPanel.ToolTip>
                <Image x:Name="ProviderIconImage"
                       Width="14"
                       Height="14"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform" />
                <ItemsControl ItemsSource="{Binding UsageWindows}" ItemTemplate="{StaticResource TaskbarUsageMetricTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Claude">
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/claude.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Antigravity">
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/antigravity.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Cursor">
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/cursor.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Codex">
                    <Setter TargetName="ProviderIconImage" Property="Source" Value="/AIUsageMonitor;component/Assets/provider-icons/codex.png" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Hit-testable so hover tooltips and the right-click menu work; left-click still does
         nothing (no handler wired to it), and the window never steals focus/activation regardless
         (ShowActivated, Focusable, and the WS_EX_NOACTIVATE style applied in code-behind). -->
    <ItemsControl x:Name="ProvidersItemsControl"
                  VerticalAlignment="Center"
                  ItemTemplate="{StaticResource TaskbarProviderTemplate}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</Window>
